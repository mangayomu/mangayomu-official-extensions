{
  "manifestVersion": 1,
  "id": "local-source",
  "name": "Local Source",
  "version": "1.0.0",
  "publisher": "MangaYomu",
  "tags": ["source", "official", "local"],
  "entrypoints": {
    "server": "server/index.mjs",
    "client": "client/index.mjs"
